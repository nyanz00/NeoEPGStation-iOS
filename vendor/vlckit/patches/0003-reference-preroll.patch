+bool AV1_get_preroll_config(const av1_OBU_sequence_header_t *s, neo_av1_preroll_config *c)
+{
+    if (!s || !c) return false;
+    *c = (neo_av1_preroll_config) {
+        .reduced_still = s->reduced_still_picture_header,
+        .decoder_model = s->decoder_model_info_present_flag,
+        .frame_ids = s->frame_id_numbers_present_flag,
+        .operating_points_minus1 = s->operating_points_cnt_minus_1,
+        .screen_tools = s->seq_force_screen_content_tools,
+        .integer_mv = s->seq_force_integer_mv,
+        .order_hint_bits = s->enable_order_hint ? 1 + s->order_hint_bits_minus_1 : 0,
+    };
+    return true;
+}
 
