+/* Only omit HEVC _N access units at the highest active SPS temporal layer.
+ * FillReorderInfo has consumed POC/SEI; inspect ALL slices before dropping. */
+static bool NonReferenceHEVC(decoder_t *dec, const block_t *block)
+{
+    struct vt_hevc_context *ctx = ((decoder_sys_t *)dec->p_sys)->p_codec_context;
+    hxxx_iterator_ctx_t it;
+    hxxx_iterator_init(&it, block->p_buffer, block->i_buffer, ctx->hh.i_output_nal_length_size);
+    const uint8_t *nal; size_t size;
+    bool slice = false;
+    while (it.p_head < it.p_tail)
+    {
+        if (!hxxx_iterate_next(&it, &nal, &size))
+            return false;
+        if (size < 2 || (nal[0] & 0x80) || hevc_getNALLayer(nal) != 0)
+            return false;
+        if (hevc_getNALType(nal) >= 32)
+            continue;
+        hevc_slice_segment_header_t *sl = hevc_decode_slice_header(nal, size, true, GetxPSHEVC, ctx);
+        if (!sl) return false;
+        hevc_picture_parameter_set_t *pps = NULL;
+        hevc_sequence_parameter_set_t *sps = NULL;
+        hevc_video_parameter_set_t *vps = NULL;
+        GetxPSHEVC(hevc_get_slice_pps_id(sl), ctx, &pps, &sps, &vps);
+        bool safe = neo_hevc_preroll_nal(nal, size, hevc_get_highest_temporal_id(sps));
+        hevc_rbsp_release_slice_header(sl);
+        if (!safe) return false;
+        slice = true;
+    }
+    return slice;
+}
+
+static bool NonReferencePreroll(decoder_t *dec, const block_t *block)
+{
+    decoder_sys_t *sys = dec->p_sys;
+    if (sys->codec == kCMVideoCodecType_H264)
+        return NonReferenceH264(dec, block);
+    if (!sys->b_skip_reference_preroll)
+        return false;
+    if (sys->codec == kCMVideoCodecType_HEVC)
+        return NonReferenceHEVC(dec, block);
+    if (sys->codec == kCMVideoCodecType_AV1)
+    {
+        struct vt_av1_context *ctx = sys->p_codec_context;
+        return ctx->preroll_droppable;
+    }
+    return false;
+}
