+/* AV1 reference-slot refresh rules are owned by Apple's decoder. Ask it to
+ * skip only droppable frames during ordered AV1 preroll. Restore AllFrames
+ * before submitting the first displayable temporal unit. An unsupported
+ * optional property keeps the full, precise decode path. */
+static bool SetAV1PrerollFilter(decoder_t *dec, bool enabled)
+{
+    decoder_sys_t *sys = dec->p_sys;
+    if (sys->codec != kCMVideoCodecType_AV1 ||
+        sys->b_av1_references_only == enabled ||
+        (enabled && sys->b_av1_filter_unsupported))
+        return true;
+    OSStatus status = VTSessionSetProperty(sys->session,
+        kVTDecompressionPropertyKey_OnlyTheseFrames,
+        enabled ? kVTDecompressionProperty_OnlyTheseFrames_NonDroppableFrames
+                : kVTDecompressionProperty_OnlyTheseFrames_AllFrames);
+    msg_Dbg(dec, "neo-preroll-filter enabled=%u accepted=%u status=%d",
+        (unsigned)enabled, (unsigned)(status == noErr), (int)status);
+    if (status == noErr)
+        sys->b_av1_references_only = enabled;
+    else if (enabled)
+        sys->b_av1_filter_unsupported = true;
+    else
+    {
+        /* Never leave normal playback in a frame-dropping mode if restoring
+         * the optional property fails. Use the existing one-way fallback. */
+        var_Create(dec, "videotoolbox-failed", VLC_VAR_VOID);
+        return false;
+    }
+    return true;
 }

