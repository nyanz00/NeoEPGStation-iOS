+/* Only decoder-only preroll may use the deeper, bounded submission queue.
+ * VT retains its reference pictures but is asked not to allocate output images.
+ * Keep ordinary display pacing and the output-memory bound unchanged. */
+static void WaitPrerollSlot(struct pic_pacer *pacer)
+{
+    vlc_mutex_lock(&pacer->lock);
+    while (pacer->queued_fields_for_decode >= 16 * 2)
+        vlc_cond_wait(&pacer->wait, &pacer->lock);
+    vlc_mutex_unlock(&pacer->lock);
+}
+
+static void ReportPreroll(decoder_t *dec)
+{
+    decoder_sys_t *sys = dec->p_sys; /* Caller holds sys->lock. */
+    if (!sys->b_preroll_stats_pending)
+        return;
+    msg_Dbg(dec, "neo-preroll-ready optimized=%u frames=%u noOutput=%u pictures=%u waitUs=%"PRId64" elapsedUs=%"PRId64" dropped=%u",
+        (unsigned)sys->b_skip_preroll_output, sys->preroll_frames,
+        sys->preroll_no_output, sys->preroll_pictures,
+        sys->preroll_wait, vlc_tick_now() - sys->preroll_started, sys->preroll_dropped);
+    sys->b_preroll_stats_pending = false;
+}
+
+/* Do not submit non-reference H.264 pictures that cannot be displayed.
+ * ProcessBlock/CreateReorderInfo have already consumed SPS/PPS/SEI and POC.
+ * Require every VCL NAL to be an ordinary non-reference slice; uncertain,
+ * partitioned, extension, IDR and mixed-reference access units stay intact. */
+static bool NonReferenceH264(decoder_t *dec, const block_t *block)
+{
+    decoder_sys_t *sys = dec->p_sys;
+    if (sys->codec != kCMVideoCodecType_H264)
+        return false;
+    struct vt_h264_context *ctx = sys->p_codec_context;
+    hxxx_iterator_ctx_t it;
+    hxxx_iterator_init(&it, block->p_buffer, block->i_buffer,
+                       ctx->hh.i_output_nal_length_size);
+    const uint8_t *nal; size_t size;
+    bool slice = false;
+    while (hxxx_iterate_next(&it, &nal, &size))
+    {
+        if (!size || (nal[0] & 0x80))
+            return false;
+        unsigned type = nal[0] & 0x1f;
+        if (type == H264_NAL_SLICE)
+        {
+            if (nal[0] & 0x60)
+                return false;
+            slice = true;
+        }
+        else if (type <= H264_NAL_SLICE_IDR || (type >= 19 && type <= 21))
+            return false;
+    }
+    return slice;
+}
