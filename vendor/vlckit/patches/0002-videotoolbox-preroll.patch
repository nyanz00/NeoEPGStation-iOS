+
+/* Only decoder-only preroll may use the deeper, bounded submission queue.
+ * VT retains its reference pictures but is asked not to allocate output images.
+ * Keep ordinary display pacing and the output-memory bound unchanged. */
+static void WaitPrerollSlot(struct pic_pacer *pacer)
+{
+    vlc_mutex_lock(&pacer->lock);
+    while (pacer->queued_fields_for_decode >= 16 * 2)
+        vlc_cond_wait(&pacer->wait, &pacer->lock);
+    vlc_mutex_unlock(&pacer->lock);
+}
+
+static void ReportPreroll(decoder_t *dec)
+{
+    decoder_sys_t *sys = dec->p_sys; /* Caller holds sys->lock. */
+    if (!sys->b_preroll_stats_pending)
+        return;
+    msg_Dbg(dec, "neo-preroll-ready optimized=%u frames=%u noOutput=%u pictures=%u waitUs=%"PRId64" elapsedUs=%"PRId64,
+        (unsigned)sys->b_skip_preroll_output, sys->preroll_frames,
+        sys->preroll_no_output, sys->preroll_pictures,
+        sys->preroll_wait, vlc_tick_now() - sys->preroll_started);
+    sys->b_preroll_stats_pending = false;
 }

