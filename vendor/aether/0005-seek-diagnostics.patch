+// A timed-out getter may still be inside mediaserverd. Keep its admission
+// until the actual worker returns, not merely until the caller's deadline.
+private final class NeoSeekDiagnosticReadGate: @unchecked Sendable {
+    static let shared = NeoSeekDiagnosticReadGate()
+    private let lock = NSLock()
+    private var busy = false
+    func claim() -> Bool {
+        lock.lock(); defer { lock.unlock() }
+        guard !busy else { return false }; busy = true; return true
+    }
+    func finish() { lock.lock(); busy = false; lock.unlock() }
+}
+
 extension AetherEngine {
 
+    /// Neo comparison: bounded, read-only measurements. A process-wide single-worker
+    /// gate survives timeouts; a wedged media server cannot accumulate read threads.
+    /// No URLs, headers or log strings leave the engine.
+    public func neoSeekDiagnostics(atDisplayTime target: Double) async -> [String: Double] {
+        guard target.isFinite else { return [:] }
+        let sourceTarget = PresentationAxis.source(displayTime: target, origin: sourcePresentationOrigin)
+        let itemTarget = presentationAxisMap.itemSeconds(forSourceSeconds: sourceTarget)
+            ?? (sourceTarget - playlistShiftSeconds)
+        var fields: [String: Double] = ["targetMs": target * 1000, "itemTargetMs": itemTarget * 1000,
+            "sourceOriginMs": sourcePresentationOrigin * 1000, "playlistShiftMs": playlistShiftSeconds * 1000]
+        if let session = nativeVideoSession {
+            fields.merge(session.neoSeekCacheDiagnostics(at: itemTarget)) { _, new in new }
+        }
+        guard let host = nativeHost, let item = currentAVPlayerItem else {
+            fields["avSampleAvailable"] = 0; return fields
+        }
+        let gate = NeoSeekDiagnosticReadGate.shared
+        guard gate.claim() else {
+            fields["avSampleAvailable"] = 0; fields["avReadBusy"] = 1; return fields
+        }
+        let player = host.avPlayer
+        let before = ProcessInfo.processInfo.systemUptime
+        let reading: [String: Double]? = await AVFoundationOffMain.read((player, item), timeout: 0.15) { refs in
+            defer { gate.finish() }
+            let (player, item) = refs
+            let now = CMTimeGetSeconds(item.currentTime())
+            var ahead: Double = 0
+            var targetAhead: Double = -1
+            for value in item.loadedTimeRanges {
+                let range: CMTimeRange = value.timeRangeValue
+                let start: Double = CMTimeGetSeconds(range.start)
+                let end: Double = CMTimeGetSeconds(CMTimeRangeGetEnd(range))
+                guard start.isFinite, end.isFinite else { continue }
+                if start <= now + 0.05 && end >= now && end - now > ahead { ahead = end - now }
+                if start <= itemTarget + 0.05 && end >= itemTarget && end - itemTarget > targetAhead {
+                    targetAhead = end - itemTarget
+                }
+            }
+            let reason = player.reasonForWaitingToPlay
+            var code: Double = 0
+            if reason == .toMinimizeStalls { code = 1 }
+            else if reason == .evaluatingBufferingRate { code = 2 }
+            else if reason != nil { code = 3 }
+            var result: [String: Double] = [:]
+            result["avSampleAvailable"] = 1
+            result["avTimeControl"] = Double(player.timeControlStatus.rawValue)
+            result["avWaitingReason"] = code
+            result["avItemMs"] = now.isFinite ? now * 1000 : -1
+            result["avAheadMs"] = ahead * 1000
+            result["avTargetAheadMs"] = targetAhead < 0 ? -1 : targetAhead * 1000
+            result["avBufferEmpty"] = item.isPlaybackBufferEmpty ? 1 : 0
+            result["avLikelyToKeepUp"] = item.isPlaybackLikelyToKeepUp ? 1 : 0
+            return result
+        }
+        fields["avReadMs"] = (ProcessInfo.processInfo.systemUptime - before) * 1000
+        if let reading { fields.merge(reading) { _, new in new } }
+        else { fields["avSampleAvailable"] = 0; fields["avReadTimedOut"] = 1 }
+        return fields
+    }
