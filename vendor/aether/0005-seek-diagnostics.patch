     /// The cache read stays OUTSIDE `restartLock` like every other forwarder above: the plan is a
     /// COW array, so snapshotting it is a retain, and nesting the cache's condition under the
     /// restart lock would add a lock order this file does not otherwise have.
+    /// Read only in-memory cache metadata and lifetime counters; no file enumeration.
+    func neoSeekCacheDiagnostics(at seconds: Double) -> [String: Double] {
+        restartLock.lock()
+        let plan = segmentPlan
+        let cacheRef = cache
+        restartLock.unlock()
+        var result: [String: Double] = [:]
+        result["sourceBytes"] = Double(demuxerBytesFetched)
+        result["muxedBytes"] = Double(muxedBytesLifetime)
+        result["serverBytes"] = Double(serverLifetimeBytesSent)
+        result["serverRequests"] = Double(serverRequestCount)
+        result["producerRestarts"] = Double(producerRestartCount)
+        guard seconds.isFinite, !plan.isEmpty else { return result }
+        var lower = 0
+        var upper = plan.count
+        while lower < upper {
+            let middle = lower + (upper - lower) / 2
+            if plan[middle].startSeconds <= seconds { lower = middle + 1 } else { upper = middle }
+        }
+        let index = min(max(lower - 1, 0), plan.count - 1)
+        result["segmentIndex"] = Double(index)
+        result["segmentStartMs"] = plan[index].startSeconds * 1000
+        result["segmentDurationMs"] = plan[index].durationSeconds * 1000
+        result["segmentOffsetMs"] = (seconds - plan[index].startSeconds) * 1000
+        let ranges = cacheRef?.residentIndexRanges() ?? []
+        result["targetResident"] = ranges.contains(where: { $0.contains(index) }) ? 1 : 0
+        return result
+    }
