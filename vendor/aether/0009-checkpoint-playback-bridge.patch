+    /// Resident bytes only. Reads on a utility worker and never moves the feed
+    /// cursor or demuxer. Expired history is a miss, not another network fetch.
+    func neoCheckpointKeyframe(at seconds: Double) -> Double? {
+        condition.lock(); defer { condition.unlock() }
+        return keyframes.filter { $0.seconds <= seconds }.map(\.seconds).max()
+    }
+    func neoCheckpointRun(from seconds: Double, through end: Double) -> [SoftwareStoredPacket] {
+        let deadline = ContinuousClock.now.advanced(by: .milliseconds(250))
+        condition.lock()
+        let usable = !closed && !sourceRepositioning && !resetPending && retainedPacketsUsableLocked
+        let anchor = usable ? keyframes.filter { $0.seconds <= seconds }.max { $0.seconds < $1.seconds } : nil
+        condition.unlock()
+        guard let anchor, seconds - anchor.seconds <= 120 else { return [] }
+        var result: [SoftwareStoredPacket] = [], bytes = 0
+        do {
+            try fifo.readHistory(from: anchor.cursor) { data in
+                if ContinuousClock.now >= deadline || result.count >= 4096 || bytes >= 32*1024*1024 { return false }
+                let packet = try SoftwareStoredPacket.decode(data)
+                guard packet.streamIndex == video.index else { return true }
+                guard let position = videoSeconds(pts: packet.pts), position <= end else { return false }
+                if result.isEmpty && packet.flags & 1 == 0 { return false }
+                bytes += packet.bytes.count; result.append(packet); return true
+            }
+        } catch { return [] }
+        return result
     }
 
