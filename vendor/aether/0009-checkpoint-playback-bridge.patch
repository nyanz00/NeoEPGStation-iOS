+/// Host-installed experimental AV1 decoder. Packet/frame pointers are synchronous
+/// borrows; the regular software renderer and audio clock remain engine-owned.
+public protocol NeoAV1PlaybackDecoding: AnyObject, Sendable {
+    func open(stream: UnsafeMutablePointer<AVStream>) throws
+    func decode(packet: UnsafeMutablePointer<AVPacket>?, emit: @escaping @Sendable (UnsafeMutablePointer<AVFrame>) -> Void) -> Int32
+    func flush()
+    func prepareCheckpointSeek(to sourceSeconds: Double, afterKeyframe: Double)
+    func close()
+}
+public enum NeoAV1PlaybackBridge {
+    private static let lock = NSLock()
+    nonisolated(unsafe) private static var factory: (@Sendable () -> any NeoAV1PlaybackDecoding)?
+    public static func install(_ value: (@Sendable () -> any NeoAV1PlaybackDecoding)?) {
+        lock.lock(); factory = value; lock.unlock()
+    }
+    static func make() -> (any NeoAV1PlaybackDecoding)? {
+        lock.lock(); let value = factory; lock.unlock(); return value?()
+    }
+}
+public struct NeoAV1PacketData: Sendable {
+    public let bytes: Data
+    public let pts, dts, duration, position: Int64
+    public let flags: Int32
+    init(_ p: SoftwareStoredPacket) {
+        bytes = p.bytes; pts = p.pts; dts = p.dts; duration = p.duration
+        position = p.position; flags = p.flags
+    }
+}
+public struct NeoAV1PacketRun: Sendable {
+    public let sourcePosition: Double
+    public let secondsPerTick: Double
+    public let packets: [NeoAV1PacketData]
+}
